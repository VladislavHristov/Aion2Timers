<Window x:Class="Aion2RiftOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:Width="300" d:Height="180"
        Title="AION 2 Space Rift Overlay"
        Width="300"
        SizeToContent="Height"
        MaxWidth="300"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        Topmost="{Binding IsTopMost, Mode=TwoWay}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="GlyphButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <TextBlock Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelCheck" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#C6D4E2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="14"
            BorderThickness="1"
            BorderBrush="#5A2E9EDC"
            Background="#D90C141E"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown"
            ToolTip="Drag to move · Click ⚙ for settings">

        <Grid Margin="18,10,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Aion2 x Sxystar"
                           FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center"/>

                <Ellipse Grid.Column="1" Width="7" Height="7" Fill="#3BE477"
                         VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding StatusText}"
                           FontFamily="Segoe UI" FontSize="10"
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>

                <Button Grid.Column="3" Content="S" Style="{StaticResource GlyphButton}"
                        FontSize="10" FontWeight="Bold"
                        Command="{Binding ToggleSettingsCommand}"
                        ToolTip="Settings: opacity, always on top, lock position, tray"/>
                <Button Grid.Column="4" Content="_" Style="{StaticResource GlyphButton}" Margin="2,0,0,0"
                        Click="MinimizeButton_Click"
                        ToolTip="Minimize (to tray when enabled in settings)"/>
            </Grid>

            <!-- Title -->
            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <TextBlock Text="SPACE RIFT"
                           FontFamily="Segoe UI" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
                <Rectangle Height="2" Width="52" HorizontalAlignment="Left" Margin="1,3,0,0"
                           Fill="{StaticResource AccentDimBrush}" RadiusX="1" RadiusY="1"/>
            </StackPanel>

            <!-- Countdown -->
            <TextBlock Grid.Row="2"
                       Text="{Binding CountdownText}"
                       FontFamily="Consolas" FontSize="38" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"
                       HorizontalAlignment="Center" Margin="0,10,0,6">
                <TextBlock.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="14" Opacity="0.55" Color="#2D9CDB"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- Next opening -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="NEXT OPENING"
                           FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding NextOpeningText}"
                           FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"
                           ToolTip="Next Space Rift opening in local Sofia time (HH:mm)"/>
            </Grid>

            <!-- Settings panel -->
            <Border x:Name="SettingsPanel" Grid.Row="4"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="10" Padding="12,10,12,12"
                    Margin="0,12,0,0"
                    Visibility="{Binding SettingsPanelOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="OPACITY" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Right"
                                   FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Text="{Binding OpacityPercent, StringFormat={}{0:F0}%}"/>
                    </Grid>
                    <Slider Minimum="20" Maximum="100"
                            Value="{Binding OpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,4,0,8"
                            ToolTip="Background transparency 20-100%. Countdown text stays fully opaque."
                            Foreground="{StaticResource AccentDimBrush}"/>

                    <CheckBox Style="{StaticResource PanelCheck}" Content="Always on top"
                              IsChecked="{Binding IsTopMost, Mode=TwoWay}"
                              ToolTip="Keep the overlay above other windows."/>
                    <CheckBox Style="{StaticResource PanelCheck}" Content="Lock position (no dragging)"
                              IsChecked="{Binding IsLocked, Mode=TwoWay}"
                              ToolTip="Prevent moving the window by dragging."/>
                    <CheckBox Style="{StaticResource PanelCheck}" Content="Minimize to system tray"
                              IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                              ToolTip="When minimized, hide to the tray instead of the taskbar."/>                    <CheckBox Style="{StaticResource PanelCheck}" Content="Voice alerts (10 min + opening)"
                              IsChecked="{Binding VoiceAlertsEnabled, Mode=TwoWay}"
                              ToolTip="Play 10minutes.mp3 ten minutes before each opening and OpenNow.mp3 at the opening time."/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="RESET POSITION" Margin="0,0,4,0"
                                Command="{Binding ResetPositionCommand}" Cursor="Hand"
                                ToolTip="Move the overlay back to the center of the current screen.">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#1A2D9CDB" CornerRadius="6" Padding="0,7,0,7" BorderBrush="#3B2D9CDB" BorderThickness="1">
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#BFDFF5" HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#2E2D9CDB"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#442D9CDB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="1" Content="CLOSE APP" Margin="4,0,0,0"
                                Command="{Binding CloseCommand}" Cursor="Hand"
                                ToolTip="Exit the application.">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#2BE05C5C" CornerRadius="6" Padding="0,7,0,7" BorderBrush="#4BE05C5C" BorderThickness="1">
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#FFD9D9" HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#44E05C5C"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#66E05C5C"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>



