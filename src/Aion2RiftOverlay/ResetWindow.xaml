<Window x:Class="Aion2RiftOverlay.ResetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset Timer"
        Width="132"
        SizeToContent="Height"
        MaxWidth="132"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <Style x:Key="GlyphButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#8FA3B8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <TextBlock Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33E05C5C"/>
                                <Setter Property="Foreground" Value="#FF7B7B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#55E05C5C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="#5A2E9EDC"
            Background="#D90C141E"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown"
            ToolTip="Drag to move">
        <Grid Margin="8,5,8,7">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Aion2"
                           FontFamily="Segoe UI" FontSize="8" FontWeight="SemiBold"
                           Foreground="#8FA3B8" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="x" Style="{StaticResource GlyphButton}"
                        Click="CloseButton_Click"
                        ToolTip="Hide this overlay (re-enable it in the main overlay's settings)"/>
            </Grid>

            <!-- Title -->
            <StackPanel Grid.Row="1" Margin="0,3,0,0">
                <TextBlock Text="{Binding TitleText}"
                           FontFamily="Segoe UI" FontSize="8.5" FontWeight="Bold"
                           Foreground="#EAF6FF"/>
                <Rectangle Height="1.5" Width="26" HorizontalAlignment="Left" Margin="0.5,2,0,0"
                           Fill="#2D9CDB" RadiusX="0.75" RadiusY="0.75"/>
            </StackPanel>

            <!-- Countdown -->
            <TextBlock Grid.Row="2"
                       Text="{Binding CountdownText}"
                       FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                       Foreground="#4FE1FF"
                       HorizontalAlignment="Center" Margin="0,4,0,2">
                <TextBlock.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="0.55" Color="#2D9CDB"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- Next reset -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="NEXT RESET"
                           FontFamily="Segoe UI" FontSize="6.5" FontWeight="SemiBold"
                           Foreground="#6F8093" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding NextResetText}"
                           FontFamily="Consolas" FontSize="9" FontWeight="Bold"
                           Foreground="#EAF6FF" VerticalAlignment="Center"
                           ToolTip="Next reset time in local Sofia time"/>
            </Grid>
        </Grid>
    </Border>
</Window>