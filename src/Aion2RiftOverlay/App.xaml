<Application x:Class="Aion2RiftOverlay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#4FE1FF"/>
        <SolidColorBrush x:Key="AccentDimBrush" Color="#2D9CDB"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#EAF6FF"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8FA3B8"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6F8093"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#F5101820"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="PressedBrush" Color="#3BFFFFFF"/>
    </Application.Resources>
</Application>
